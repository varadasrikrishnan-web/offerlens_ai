# -------------------------------------------------
# Secrets: never upload API keys or local env files
# -------------------------------------------------
.env
*.env
!.env.example

# -------------------------------------------------
# Python virtual environments and generated caches
# -------------------------------------------------
.venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class

# -------------------------------------------------
# React / Vite generated packages and build output
# -------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# -------------------------------------------------
# Logs
# -------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------
# Editor directories and operating-system files
